<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>LOGCOIN</title>
    <%- include("../component/head") %>
    <script src="/js/auth/register.js" defer></script>
    <link rel="stylesheet" type="text/css" href="/css/home/surveyNFTStore.css">
</head>
<body>
<div class="filter"></div>
<div class="pop_menu" style="display: none;">
    <ul>
        <li class="close"><i class="fa-solid fa-xmark"></i></li>
        <li><a href="/myWallet"><p><i class="fa-solid fa-link"></i></p>LOGCASH</a></li>
        <li><a href="/surveyInProgress"><p><i class="fa-solid fa-pencil"></i></p>설문조사</a></li>
        <li><a href="/surveyNFTStore"><p><i class="fa-solid fa-cart-shopping"></i></p>NFT스토어</a></li>
        <li><a href="/myWallet"><p><i class="fa-solid fa-wallet"></i></p>내 지갑</a></li>
        <li><a href="#"><p><i class="fa-solid fa-flag"></i></p>고객센터</a></li>
        <li><a href="/"><p><i class="fa-solid fa-user"></i></p>로그인</a></li>
        <li><a href="/auth/register"><p><i class="fa-solid fa-right-to-bracket"></i></p>회원가입</a></li>
    </ul>
</div>
<header>
    <div class="header_wrap">
        <div class="header_logo">
            <a href="/"><img src="/images/logo.png"></a>
        </div>
        <div class="header_menu">
            <ul>
                <li><a href="/myWallet">LOGCASH</a></li>
                <li><a href="/surveyInProgress">설문조사</a></li>
                <li><a href="/surveyNFTStore">NFT스토어</a></li>
                <li><a href="/myWallet">내 지갑</a></li>
                <li><a href="#">고객센터</a></li>
                <li class="search"><p><span class="search_icon"><i class="fa-solid fa-magnifying-glass"></i></span><input type="text" placeholder="Search.."></p></li>
            </ul>
        </div>


        <div class="header_login">
            <div class="login">
                <a href="/">로그인</a>
            </div>
            <div class="join">
                <a href="/auth/register">회원가입</a>
            </div>
        </div>
        <div class="hambuger navbar_toggleBtn" style="display: none;">
            <i class="fa-solid fa-bars"></i>
        </div>
    </div>
</header>

<section class="login_section">
    <div class="login_wrap">
        <div class="login_box">
            <div class="login_title">
                <p>Logcash</p>
            </div>
            <div class="login_input">
                <ul>
                    <li><p class="input_title">Gender</p>
                        <label for="male">
                            <input type="radio" id="male" name="gender" value="male" required checked>
                            <span>남성</span>
                        </label>

                        <label for="female">
                            <input type="radio" id="female" name="gender" value="female">
                            <span>여성</span>
                        </label>
                    </li>

                    <li><p class="input_title">Age</p>
                        <select id="age" name="age">
                            <option value="">나이대를 선택해주세요.</option>
                            <option value="10대">10대</option>
                            <option value="20대">20대</option>
                            <option value="30대">30대</option>
                            <option value="40대">40대</option>
                            <option value="50대">50대</option>
                            <option value="60대 이상"> 60대 이상</option>
                        </select>
                    </li>


                    <li><p class="input_title">Email / Username</p>
                        <input id="email" type="text" name="" class="login_i"></li>

                    <li><p class="input_title">Password</p>
                        <input id="password" type="password" name="" class="login_i"></li>

                    <li><p class="input_title">Confirm Password</p>
                        <input id="passwordCheck" type="password" name="" class="login_i"></li>

                    <li><p class="input_title">Solana Wallet Address</p>
                        <input id="walletAddress" type="text" name="address" class="login_i"></li>

                    <li><input id="submit" type="submit" name="" value="Join" class="login_b"></li>
                    <li class="join_input"><a href="/">Login</a></li>
                </ul>
            </div>
        </div>
    </div>
</section>
</body>
</html>
